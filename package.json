{
  "name": "deeplx-serverless",
  "version": "4.2.0",
  "description": "DeepL free API for Serverless",
  "type": "module",
  "main": "src/server.js",
  "keywords": [
    "deeplxs",
    "deepl",
    "translate",
    "serverless"
  ],
  "author": "guobao2333",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "start:node": "node --env-file=.env src/server.js",
    "start:bun": "bun run src/server.js",
    "start:deno": "deno run --allow-net --allow-env --allow-read src/server.js",

    "test": "node test.js",
    "test:post": "node test_post.js"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "@hono/node-server": "^2.1.5"
  }
}
