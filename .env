# 端口号
# Type: Number
# Default: 6119
PORT=6119

# 跨域请求
# 注意：非字符串不要使用引号包裹，以免被当做字符串处理！
# Type: Array | Boolean | Function | String | RegExp
# Default: false (Disable)
# Example:
# 允许某个具体站点
#CORS_ORIGIN=https://example.com
#
# 允许多个站点
#CORS_ORIGIN=https://a.example.com,https://b.example.com
#
# 允许任意子域（正则）
#CORS_ORIGIN=/^https?:\/\/([a-z0-9-]+\.)*example\.com(:\d+)?$/
#
# 允许所有（等价于 '*'）
#CORS_ORIGIN=*
#
# 禁用（默认）
CORS_ORIGIN=false
